APP_NAME="Community WiFi Bradha Matu"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://console.example.com

# Set these once during initial installation; do not re-run the seeder during deployment.
SUPERADMIN_NAME="Network Administrator"
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=

# Create a dedicated cPanel MySQL/MariaDB database and least-privilege user.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_console
DB_USERNAME=cpaneluser_console
DB_PASSWORD=

# Persistent database-backed stores; no Redis service is assumed.
CACHE_STORE=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=daily
LOG_LEVEL=notice
LOG_DAILY_DAYS=14

# Use REST only after the host confirms an approved private route to the router.
# This setting does not create network access or justify public port forwarding.
# Binary API remains available for local development; mock data is fictional.
ROUTER_PROVIDER=rest
MIKROTIK_CONNECT_TIMEOUT=3
MIKROTIK_QUERY_TIMEOUT=5
MIKROTIK_ALLOWED_PORTS=8728,8729
MIKROTIK_ALLOWED_HOSTS=
# RouterOS REST requires HTTPS. Its port is fixed by server configuration,
# never selected by browser requests. Use only a provider-approved private route.
MIKROTIK_REST_PORT=443
MIKROTIK_REST_ALLOWED_PORTS=443
# Optional absolute CA bundle path. Certificate and hostname verification
# remain enabled whether or not a custom CA bundle is configured.
# MIKROTIK_TLS_CA_FILE=/home/cpaneluser/private/router-ca.pem
