APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SUPERADMIN_NAME="Network Administrator"
SUPERADMIN_EMAIL=admin@bradhamatu.com
SUPERADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# M-Pesa/Daraja
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORT_CODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=

# Hosted payment gateways. Keep all credentials server-side.
# Register https://your-api-host/api/payment-webhooks/pesapal as a Pesapal IPN first.
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_CURRENCY=KES
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET_HASH=
FLW_CURRENCY=KES
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES

# Customer checkout returns here after hosted checkout. Production must use HTTPS.
FRONTEND_URL=https://your-console-host

# Private FreeRADIUS provisioning API over the approved VPN/private route.
# Keep the client private key and passphrase outside the repository.
RADIUS_PROVISIONING_URL=https://radius-api.internal.example
RADIUS_PROVISIONING_ALLOWED_HOST=radius-api.internal.example
RADIUS_PROVISIONING_CLIENT_CERT=/secure/runtime/radius-client.crt
RADIUS_PROVISIONING_CLIENT_KEY=/secure/runtime/radius-client.key
RADIUS_PROVISIONING_CLIENT_KEY_PASSPHRASE=
RADIUS_PROVISIONING_CA_BUNDLE=/secure/runtime/private-ca.crt

# RouterOS monitoring. Select mock only for an explicitly labeled demo environment.
ROUTER_PROVIDER=mikrotik
MIKROTIK_CONNECT_TIMEOUT=3
MIKROTIK_QUERY_TIMEOUT=3
MIKROTIK_ALLOWED_PORTS=8728,8729
MIKROTIK_ALLOWED_HOSTS=
# Optional CA bundle for private RouterOS TLS certificates; verification stays enabled.
# MIKROTIK_TLS_CA_FILE=
# HTTPS REST mode uses a fixed, server-approved port and verified certificates.
MIKROTIK_REST_PORT=443
MIKROTIK_REST_ALLOWED_PORTS=443
