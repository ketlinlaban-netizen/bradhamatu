APP_NAME="Community Group WiFi Console"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://onlineconsole.communitygroup.co.ke

# This instance is fully isolated from the pandatechs deployment:
# create a NEW cPanel MySQL database and user for it. Never point these at
# the existing onlineconsole.pandatechs.co.ke database.
SUPERADMIN_NAME="Network Administrator"
# Set this to the administrator email you control.
SUPERADMIN_EMAIL=
# Required only if the database has no users yet. Use a unique password (16+ chars).
SUPERADMIN_PASSWORD=
# Generate a unique random token of at least 32 characters. Remove/rotate it
# after a deployment; never put it in a URL or commit a populated .env file.
DEPLOYMENT_TOKEN=

# Create a dedicated cPanel MySQL/MariaDB database and least-privilege user.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# Set the exact prefixed database and username created in cPanel.
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Persistent database-backed stores; no Redis service is assumed.
CACHE_STORE=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

LOG_CHANNEL=daily
LOG_LEVEL=notice
LOG_DAILY_DAYS=14

# Production cPanel uses the HTTPS REST provider. Binary API remains available
# for local development; mock data is explicitly fictional demo data only.
ROUTER_PROVIDER=rest
MIKROTIK_CONNECT_TIMEOUT=3
MIKROTIK_QUERY_TIMEOUT=5
MIKROTIK_ALLOWED_PORTS=8728,8729
MIKROTIK_ALLOWED_HOSTS=
# RouterOS REST requires HTTPS. Its port is fixed by server configuration,
# never selected by browser requests. Use only a provider-approved private route.
MIKROTIK_REST_PORT=443
MIKROTIK_REST_ALLOWED_PORTS=443
# Mark telemetry stale after three missed five-second router reports.
MIKROTIK_TELEMETRY_STALE_SECONDS=15
# Optional absolute CA bundle path. Certificate and hostname verification
# remain enabled whether or not a custom CA bundle is configured.
# MIKROTIK_TLS_CA_FILE=/home/cpaneluser/private/router-ca.pem
